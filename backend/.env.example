# Server Port
PORT=3001
NODE_ENV=development

# Provider ('auto', 'gemini', 'groq', 'openai')
LLM_PROVIDER=auto

# 1. Google Gemini API Key (100% FREE - No credit card needed at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud API Key (100% FREE - Lightning fast at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI API Key (Paid / requires billing credits)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
