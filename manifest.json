{
  "manifest_version": 3,
  "name": "AI Quiz Assistant",
  "version": "1.0.0",
  "description": "Scans questions on active quiz pages (Google Forms, Microsoft Forms, Canvas, etc.), queries an LLM, and auto-selects correct options without submitting.",
  "author": "AI Quiz Assistant",

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "AI Quiz Assistant"
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/extractor.js",
        "content/matcher.js",
        "content/selector.js",
        "content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
